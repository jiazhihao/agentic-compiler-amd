kir func mo_rope_fwd(%x: ptr<f32>, %cos: ptr<f32>, %sin: ptr<f32>, %y: ptr<f32>, %output_numel: u64, %rotary_numel: u64) {
  %tid_x: u32 = tid.x
  %bid_x: u32 = bid.x
  %bdim_x: u32 = bdim.x
  %t: u32 = mul %bid_x, %bdim_x
  %t0: u32 = add %tid_x, %t
  %gid: u64 = cast %t0
  %t2: i1 = ge %gid, %output_numel
  if %t2 @if0 {
  }
  merge %t3: i1 = true:i1, false:i1
  %t4: i1 = not %t3
  if %t4 @if1 {
    %t5: i64 = cast %gid
    %p: ptr<f32> = gep %x, %t5
    %v: f32 = load %p @load0
    %freqs_id: u64 = rem %gid, %rotary_numel
    %t7: u64 = rem %gid, 2:u64
    %t8: i1 = eq %t7, 0:u64
    if %t8 @if2 {
      %t9: u64 = add %gid, 1:u64
      %t10: i64 = cast %t9
      %p11: ptr<f32> = gep %x, %t10
      %v12: f32 = load %p11 @load1
      %t13: f32 = neg %v12
    } else {
      %t14: u64 = sub %gid, 1:u64
      %t15: i64 = cast %t14
      %p16: ptr<f32> = gep %x, %t15
      %v17: f32 = load %p16 @load2
    }
    merge %t18: f32 = %t13, %v17
    %t19: i64 = cast %freqs_id
    %p20: ptr<f32> = gep %cos, %t19
    %v21: f32 = load %p20 @load3
    %t22: i64 = cast %freqs_id
    %p23: ptr<f32> = gep %sin, %t22
    %v24: f32 = load %p23 @load4
    %t25: f32 = mul %v, %v21
    %t26: f32 = mul %t18, %v24
    %val: f32 = add %t25, %t26
    %t28: i64 = cast %gid
    %p29: ptr<f32> = gep %y, %t28
    store %p29, %val @store0
  }
  merge %t30: i1 = false:i1, %t3
}
