kir func row_sum(%x: ptr<f32>, %out: ptr<f32>, %rows: i32, %cols: i32) {
  %red: lds<f32> = shared[name=red2, bytes=1024]
  %bid_x: u32 = bid.x
  %t: u64 = cast %bid_x
  %t0: u64 = cast %cols
  %t1: u64 = mul %t, %t0
  %t2: i64 = cast %t1
  %p: ptr<f32> = gep %x, %t2
  %tid_x: u32 = tid.x
  %j: i32 = cast %tid_x
  loop @loop0 {
    carry %j4: i32 = %j, %t9 -> %j4_10
    carry %acc: f32 = 0.0:f32, %t8 -> %acc11
    %t5: i1 = lt %j4, %cols
    while %t5
    %t6: i64 = cast %j4
    %p7: ptr<f32> = gep %p, %t6
    %v: f32 = load %p7 @load0
    %t8: f32 = add %acc, %v
    %t9: i32 = add[nsw=true] %j4, 256:i32
  }
  %tid_x12: u32 = tid.x
  %t13: i64 = cast %tid_x12
  %p14: lds<f32> = gep %red, %t13
  store %p14, %acc11 @store0
  barrier
  loop @loop1 {
    carry %s: i32 = 128:i32, %t33 -> %s34
    %t15: i1 = gt %s, 0:i32
    while %t15
    %tid_x16: u32 = tid.x
    %t17: u32 = cast %s
    %t18: i1 = lt %tid_x16, %t17
    if %t18 @if0 {
      %tid_x19: u32 = tid.x
      %t20: i64 = cast %tid_x19
      %p21: lds<f32> = gep %red, %t20
      %tid_x22: u32 = tid.x
      %t23: i64 = cast %tid_x22
      %p24: lds<f32> = gep %red, %t23
      %v25: f32 = load %p24 @load1
      %tid_x26: u32 = tid.x
      %t27: u32 = cast %s
      %t28: u32 = add %tid_x26, %t27
      %t29: i64 = cast %t28
      %p30: lds<f32> = gep %red, %t29
      %v31: f32 = load %p30 @load2
      %t32: f32 = add %v25, %v31
      store %p21, %t32 @store1
    }
    barrier
    %t33: i32 = shr %s, 1:i32
  }
  %p35: lds<f32> = gep %red, 0:i64
  %v36: f32 = load %p35 @load3
  barrier
  %tid_x37: u32 = tid.x
  %t38: i1 = eq %tid_x37, 0:u32
  if %t38 @if1 {
    %bid_x39: u32 = bid.x
    %t40: i64 = cast %bid_x39
    %p41: ptr<f32> = gep %out, %t40
    store %p41, %v36 @store2
  }
}
