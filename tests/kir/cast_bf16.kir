kir func cast_bf16(%x: ptr<f32>, %y: ptr<u16>, %n: i32) {
  %bid_x: u32 = bid.x
  %bdim_x: u32 = bdim.x
  %t: u32 = mul %bid_x, %bdim_x
  %tid_x: u32 = tid.x
  %t0: u32 = add %t, %tid_x
  %i: i32 = cast %t0
  %t2: i1 = lt %i, %n
  if %t2 @if0 {
    %t3: i64 = cast %i
    %p: ptr<f32> = gep %x, %t3
    %v: f32 = load %p @load0
    %u: u32 = bitcast %v
    %t5: u32 = shr %u, 16:u32
    %t6: u32 = and %t5, 1:u32
    %t7: u32 = add 32767:u32, %t6
    %t8: u32 = add %u, %t7
    %t9: i64 = cast %i
    %p10: ptr<u16> = gep %y, %t9
    %t11: u32 = shr %t8, 16:u32
    %t12: u16 = cast %t11
    store %p10, %t12 @store0
  }
}
