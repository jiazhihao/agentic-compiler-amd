    %t8: i64 = cast %t7
    %p9: ptr<f32> = gep %x, %t8
    %j: i32 = sub[nsw=true] %cols, 1:i32
    loop @loop0 {
      carry %j11: i32 = %j, %j22 -> %j11_23
