kir func transpose(%x: ptr<f32>, %y: ptr<f32>, %rows: i32, %cols: i32) {
  %bid_x: u32 = bid.x
  %bdim_x: u32 = bdim.x
  %t: u32 = mul %bid_x, %bdim_x
  %tid_x: u32 = tid.x
  %t0: u32 = add %t, %tid_x
  %j: i32 = cast %t0
  %bid_y: u32 = bid.y
  %bdim_y: u32 = bdim.y
  %t2: u32 = mul %bid_y, %bdim_y
  %tid_y: u32 = tid.y
  %t3: u32 = add %t2, %tid_y
  %i: i32 = cast %t3
  %t5: i1 = lt %i, %rows
  %t6: i1 = lt %j, %cols
  %c: i1 = and %t5, %t6
  if %c @if0 {
    %t7: u64 = cast %j
    %t8: u64 = cast %rows
    %t9: u64 = mul %t7, %t8
    %t10: u64 = cast %i
    %t11: u64 = add %t9, %t10
    %t12: i64 = cast %t11
    %p: ptr<f32> = gep %y, %t12
    %t13: u64 = cast %i
    %t14: u64 = cast %cols
    %t15: u64 = mul %t13, %t14
    %t16: u64 = cast %j
    %t17: u64 = add %t15, %t16
    %t18: i64 = cast %t17
    %p19: ptr<f32> = gep %x, %t18
    %v: f32 = load %p19 @load0
    store %p, %v @store0
  }
}
