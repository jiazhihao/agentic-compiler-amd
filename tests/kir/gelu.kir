kir func gelu(%x: ptr<f32>, %y: ptr<f32>, %n: i32) {
  %bid_x: u32 = bid.x
  %bdim_x: u32 = bdim.x
  %t: u32 = mul %bid_x, %bdim_x
  %tid_x: u32 = tid.x
  %t0: u32 = add %t, %tid_x
  %i: i32 = cast %t0
  %t2: i1 = lt %i, %n
  if %t2 @if0 {
    %t3: i64 = cast %i
    %p: ptr<f32> = gep %x, %t3
    %v: f32 = load %p @load0
    %t4: i64 = cast %i
    %p5: ptr<f32> = gep %y, %t4
    %t6: f32 = mul 0.5:f32, %v
    %t7: f32 = mul 0.044714998453855515:f32, %v
    %t8: f32 = mul %t7, %v
    %t9: f32 = mul %t8, %v
    %t10: f32 = add %v, %t9
    %t11: f32 = mul 0.7978845834732056:f32, %t10
    %tanh: f32 = tanh %t11
    %t12: f32 = add 1.0:f32, %tanh
    %t13: f32 = mul %t6, %t12
    store %p5, %t13 @store0
  }
}
